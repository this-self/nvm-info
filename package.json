{
  "name": "nvm-info",
  "version": "0.4.0",
  "description": "CLI tool to analyze Node.js versions installed via nvm - view disk usage and global packages",
  "type": "module",
  "author": "Ihor Levchenko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/this-self/nvm-info.git"
  },
  "bugs": {
    "url": "https://github.com/this-self/nvm-info/issues"
  },
  "homepage": "https://github.com/this-self/nvm-info#readme",
  "keywords": [
    "nvm",
    "node",
    "nodejs",
    "version",
    "manager",
    "cli",
    "disk-usage",
    "analysis"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "nvm-info": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.tsx",
    "dev:watch": "tsx watch src/index.tsx",
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/react": "^18.3.27",
    "prettier": "^3.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1"
  }
}
